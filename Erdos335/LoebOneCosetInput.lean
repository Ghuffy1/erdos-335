import Erdos335.LoebZeroGrowthFamily
import Erdos335.LoebFiniteNoncriticalComponent
import Erdos335.QuasiPeriodicSets

/-!
# A pair with one input in its generated finite-index subgroup

The finite coset partition has one component accounting for the total
growth. Every other component is periodic in measure under the subgroup
generated by the first input. This gives the one-input conclusion of
Griesmer's Lemma 5.15 in the cyclic Loeb setting.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

open Filter Set MeasureTheory
open scoped Pointwise ENNReal BigOperators

noncomputable section

namespace Erdos335.Loeb

local instance oneCosetInputLoebSpace (U : Ultrafilter ℕ) (q : ℕ → ℕ+) :
    MeasurableSpace ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))) := loebMeasurableSpace U

theorem loeb_one_generated_coset_input_quasiPeriodic
    (U : Ultrafilter ℕ) (hU : (U : Filter ℕ) ≤ atTop) (q : ℕ → ℕ+)
    (A B : Set ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))))
    (H : AddSubgroup ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))))
    (hHm : MeasurableSet (H : Set ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ)))))
    (hHpos : 0 < loebMeasure (X := fun n => ZMod (q n : ℕ)) U hU (H : Set _))
    (hgen : H = AddSubgroup.closure A)
    (hAm : MeasurableSet A) (hBm : MeasurableSet B) (hSm : MeasurableSet (A + B))
    (hApos : 0 < loebMeasure U hU A) (hzero : 0 ∈ A)
    (hfull : loebMeasure U hU (A + B) = loebMeasure U hU A + loebMeasure U hU B)
    (hnotperiod : ¬ ∃ L : AddSubgroup ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))),
      MeasurableSet (L : Set ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ)))) ∧
      0 < loebMeasure (X := fun n => ZMod (q n : ℕ)) U hU (L : Set _) ∧
      (A + B) + (L : Set _) = A + B) :
    Nonempty (QuasiPeriodicDecomposition (loebMeasure U hU) H B) := by
  classical
  let G := (U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))
  let μ := loebMeasure (X := fun n => ZMod (q n : ℕ)) U hU
  obtain ⟨h, p, _, hker, _⟩ := positive_measurable_subgroup_is_natural_finite_kernel U hU q H hHm hHpos
  let φ := finiteQuotient U p
  let I := {y : ZMod (h : ℕ) // y ∈ φ '' B}
  let r (i : I) : G := Classical.choose i.property
  have hrB (i : I) : r i ∈ B := (Classical.choose_spec i.property).1
  have hrφ (i : I) : φ (r i) = i := (Classical.choose_spec i.property).2
  let P (i : I) : Set G := {x | x ∈ B ∧ φ x = i}
  have hφH (x : G) (hx : x ∈ H) : φ x = 0 := by
    change x ∈ φ.ker
    rwa [hker]
  have hφA (x : G) (hx : x ∈ A) : φ x = 0 :=
    hφH x (hgen.symm ▸ AddSubgroup.subset_closure hx)
  have hfiber (i : I) : {x : G | φ x = i} = r i +ᵥ (H : Set G) := by
    ext x
    constructor
    · intro hx
      refine ⟨x - r i, ?_, by simp⟩
      rw [← hker]
      change φ (x - r i) = 0
      rw [map_sub, hx, hrφ, sub_self]
    · rintro ⟨k, hk, rfl⟩
      change φ (r i + k) = i
      rw [map_add, hrφ, hφH k hk, add_zero]
  have hPm (i : I) : MeasurableSet (P i) := by
    change MeasurableSet (B ∩ {x | φ x = i})
    rw [hfiber]
    exact hBm.inter (measurable_loeb_coset U hU H hHm _)
  have hPne (i : I) : (P i).Nonempty := ⟨r i, hrB i, hrφ i⟩
  have hSeq (i : I) : A + P i = (A + B) ∩ {x : G | φ x = i} := by
    ext x
    constructor
    · rintro ⟨a, ha, b, hb, rfl⟩
      refine ⟨⟨a, ha, b, hb.1, rfl⟩, ?_⟩
      change φ (a + b) = i
      rw [map_add, hφA a ha, zero_add]
      exact hb.2
    · rintro ⟨⟨a, ha, b, hb, rfl⟩, hx⟩
      refine ⟨a, ha, b, ⟨hb, ?_⟩, rfl⟩
      change φ (a + b) = i at hx
      simpa only [map_add, hφA a ha, zero_add] using hx
  have hSPartm (i : I) : MeasurableSet (A + P i) := by
    rw [hSeq, hfiber]
    exact hSm.inter (measurable_loeb_coset U hU H hHm _)
  have hPdisjoint : Pairwise (fun i j : I => Disjoint (P i) (P j)) := by
    intro i j hij
    apply Set.disjoint_left.mpr
    intro x hx hy
    exact hij (Subtype.ext (hx.2.symm.trans hy.2))
  have hSdisjoint : Pairwise (fun i j : I => Disjoint (A + P i) (A + P j)) := by
    intro i j hij
    rw [hSeq, hSeq]
    apply Set.disjoint_left.mpr
    intro x hx hy
    exact hij (Subtype.ext (hx.2.symm.trans hy.2))
  have hPunion : B = ⋃ i : I, P i := by
    ext x
    constructor
    · intro hx
      exact mem_iUnion.mpr ⟨⟨φ x, x, hx, rfl⟩, hx, rfl⟩
    · intro hx
      obtain ⟨i, hi⟩ := mem_iUnion.mp hx
      exact hi.1
  have hSunion : A + B = ⋃ i : I, A + P i := by
    ext x
    constructor
    · rintro ⟨a, ha, b, hb, rfl⟩
      exact mem_iUnion.mpr ⟨⟨φ b, b, hb, rfl⟩, a, ha, b, ⟨hb, rfl⟩, rfl⟩
    · intro hx
      obtain ⟨i, a, ha, b, hb, hab⟩ := mem_iUnion.mp hx
      exact ⟨a, ha, b, hb.1, hab⟩
  have hsumP : ∑ i, μ (P i) = μ B := by
    calc
      ∑ i, μ (P i) = ∑' i, μ (P i) := (tsum_fintype (fun i => μ (P i))).symm
      _ = μ (⋃ i, P i) := (measure_iUnion hPdisjoint hPm).symm
      _ = μ B := by rw [← hPunion]
  have hsumS : ∑ i, μ (A + P i) = μ (A + B) := by
    calc
      ∑ i, μ (A + P i) = ∑' i, μ (A + P i) := (tsum_fintype (fun i => μ (A + P i))).symm
      _ = μ (⋃ i, A + P i) := (measure_iUnion hSdisjoint hSPartm).symm
      _ = μ (A + B) := by rw [← hSunion]
  have hnotperiod' : ¬ ∃ L : AddSubgroup G, MeasurableSet (L : Set G) ∧
      0 < μ (L : Set G) ∧ ((∅ : Set G) ∪ ⋃ i : I, A + P i) + (L : Set G) = ∅ ∪ ⋃ i : I, A + P i := by
    simpa only [empty_union, ← hSunion] using hnotperiod
  obtain ⟨i, hi⟩ := loeb_nonperiodic_union_base_has_noncritical_component U hU q (fun _ : I => A) P
    (fun _ => hAm) hPm (fun _ => ⟨0, hzero⟩) hPne ∅ H hHm hHpos (by simp) hnotperiod'
  have hcount : ∑ j, μ (A + P j) = μ A + ∑ j, μ (P j) := by rw [hsumS, hsumP]; exact hfull
  have hi' : μ A + μ (P i) ≤ μ (A + P i) := by
    rwa [internalInnerMeasure_eq U hU _ (hSPartm i)] at hi
  have hperiods := loeb_zero_growth_family_periodic U hU q A P hAm hPm hSPartm hApos hzero hPne hcount i hi'
  let Q := B \ P i
  have hQm : MeasurableSet Q := hBm.diff (hPm i)
  have hQperiod : μ ((Q + (H : Set G)) \ Q) = 0 := by
    have hsub : (Q + (H : Set G)) \ Q ⊆
        ⋃ j : {j : I // j ≠ i}, ((P j.val + (H : Set G)) \ P j.val) := by
      rintro x ⟨⟨b, hb, k, hk, rfl⟩, hout⟩
      let j : I := ⟨φ b, b, hb.1, rfl⟩
      have hji : j ≠ i := by
        intro heq
        apply hb.2
        refine ⟨hb.1, ?_⟩
        exact congrArg Subtype.val heq
      apply mem_iUnion.mpr
      refine ⟨⟨j, hji⟩, ⟨b, ⟨hb.1, rfl⟩, k, hk, rfl⟩, ?_⟩
      intro hx
      apply hout
      refine ⟨hx.1, ?_⟩
      intro hxi
      exact hji (Subtype.ext (hx.2.symm.trans hxi.2))
    apply measure_mono_null hsub
    apply measure_iUnion_null
    intro j
    rw [hgen]
    exact hperiods j.val j.property
  let decomp : QuasiPeriodicDecomposition μ H B := {
    active := P i
    background := Q
    anchor := r i
    active_measurable := hPm i
    background_measurable := hQm
    active_nonempty := hPne i
    partition := by
      ext x
      constructor
      · intro hx
        by_cases hxi : x ∈ P i
        · exact Or.inr hxi
        · exact Or.inl ⟨hx, hxi⟩
      · rintro (hx | hx)
        · exact hx.1
        · exact hx.1
    active_subset_coset := by
      intro x hx
      rw [← hfiber]
      exact hx.2
    separated := by
      apply Set.disjoint_left.mpr
      rintro x ⟨b, hb, k, hk, rfl⟩ hx
      apply hx.2
      refine ⟨hx.1, ?_⟩
      change φ (b + k) = i
      rw [map_add, hb.2, hφH k hk, add_zero]
    background_periodic := hQperiod
  }
  exact ⟨decomp⟩

end Erdos335.Loeb

end
