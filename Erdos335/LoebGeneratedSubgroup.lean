import Erdos335.LoebPositiveSubgroups
import Erdos335.LoebSparseCoset
import Erdos335.LoebInnerMeasure

/-!
# Measurability of a subgroup generated by a positive set

Positive inner measure supplies an internal subset with more than half
the subgroup's inner measure. The internal Kneser inequality gives a
positive internal subgroup inside the original subgroup. Saturation by
this internal subgroup proves measurability.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

open Filter Set MeasureTheory
open scoped Pointwise ENNReal

noncomputable section

namespace Erdos335.Loeb

local instance generatedSubgroupLoebSpace (U : Ultrafilter ℕ) (q : ℕ → ℕ+) :
    MeasurableSpace ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))) := loebMeasurableSpace U

theorem exists_positive_internal_subgroup_of_inner
    (U : Ultrafilter ℕ) (hU : (U : Filter ℕ) ≤ atTop) (q : ℕ → ℕ+)
    (H : AddSubgroup ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))))
    (hpos : 0 < internalInnerMeasure U hU
      (H : Set ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))))) :
    ∃ K : ∀ n, AddSubgroup (ZMod (q n : ℕ)), internalAddSubgroup U K ≤ H ∧
      0 < loebMeasure (X := fun n => ZMod (q n : ℕ)) U hU (internalAddSubgroup U K : Set _) := by
  classical
  let G := (U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))
  let μ := loebMeasure (X := fun n => ZMod (q n : ℕ)) U hU
  have : IsProbabilityMeasure μ := isProbabilityMeasure_loebMeasure U hU
  let α := internalInnerMeasure U hU (H : Set G)
  have hαfin : α ≠ ∞ := ne_top_of_le_ne_top (measure_ne_top μ H)
    (internalInnerMeasure_le U hU (H : Set G))
  let a := α.toReal
  have hapos : 0 < a := ENNReal.toReal_pos hpos.ne' hαfin
  have hhalf : ENNReal.ofReal (a / 2) < α := by
    apply (ENNReal.toReal_lt_toReal (by simp) hαfin).mp
    rw [ENNReal.toReal_ofReal (by positivity)]
    change a / 2 < a
    linarith
  obtain ⟨T, hT⟩ := lt_iSup_iff.mp hhalf
  obtain ⟨A, hA⟩ := T.2.1
  have hAH : internalSet U A ⊆ (H : Set G) := hA ▸ T.2.2
  have hlarge : a / 2 < (μ (internalSet U A)).toReal := by
    have ht := (ENNReal.toReal_lt_toReal (by simp) (measure_ne_top μ T.1)).mpr hT
    rw [ENNReal.toReal_ofReal (by positivity), ← hA] at ht
    exact ht
  have hSne : (internalSet U A).Nonempty := by
    apply nonempty_of_measure_ne_zero
    intro hz
    rw [hz, ENNReal.toReal_zero] at hlarge
    linarith
  let C := fun n => A n + A n
  let K := fun n => AddAction.stabilizer (ZMod (q n : ℕ)) (C n)
  have hCH : internalSet U C ⊆ (H : Set G) := by
    rw [internalSet_add]
    rintro x ⟨y, hy, z, hz, rfl⟩
    exact H.add_mem (hAH hy) (hAH hz)
  have hCne : (internalSet U C).Nonempty := by
    rw [internalSet_add]
    exact hSne.add hSne
  refine ⟨K, internal_stabilizer_le_of_subset U C H hCne hCH, ?_⟩
  have hbound := loebMeasure_internal_add_le U hU A A hSne hSne
  change μ (internalSet U A) + μ (internalSet U A) ≤ μ (internalSet U C) +
    μ (internalAddSubgroup U K : Set G) at hbound
  by_contra hn
  have hz : μ (internalAddSubgroup U K : Set G) = 0 := le_antisymm (not_lt.mp hn) bot_le
  rw [hz, add_zero] at hbound
  have hinner : μ (internalSet U C) ≤ α :=
    le_iSup_of_le ⟨internalSet U C, ⟨C, rfl⟩, hCH⟩ le_rfl
  have hreal := ENNReal.toReal_mono hαfin (hbound.trans hinner)
  rw [ENNReal.toReal_add (measure_ne_top μ _) (measure_ne_top μ _)] at hreal
  change (μ (internalSet U A)).toReal + (μ (internalSet U A)).toReal ≤ a at hreal
  linarith

theorem measurable_loeb_subgroup_of_positive_inner
    (U : Ultrafilter ℕ) (hU : (U : Filter ℕ) ≤ atTop) (q : ℕ → ℕ+)
    (H : AddSubgroup ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))))
    (hpos : 0 < internalInnerMeasure U hU
      (H : Set ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))))) :
    MeasurableSet (H : Set ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ)))) ∧
      0 < loebMeasure (X := fun n => ZMod (q n : ℕ)) U hU (H : Set _) := by
  let G := (U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))
  obtain ⟨K, hKH, hKpos⟩ := exists_positive_internal_subgroup_of_inner U hU q H hpos
  have hKm : MeasurableSet (internalAddSubgroup U K :
      Set ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ)))) := by
    change MeasurableSet (internalSet U (fun n => (K n : Set (ZMod (q n : ℕ)))))
    exact measurable_internalSet U _
  have hperiod : (H : Set G) + (internalAddSubgroup U K : Set G) = H := by
    apply subset_antisymm
    · rintro x ⟨h, hh, k, hk, rfl⟩
      exact H.add_mem hh (hKH hk)
    · intro x hx
      exact ⟨x, hx, 0, (internalAddSubgroup U K).zero_mem, add_zero x⟩
  refine ⟨?_, hpos.trans_le (internalInnerMeasure_le U hU
    (H : Set ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ)))) )⟩
  rw [← hperiod]
  exact measurable_saturation_of_positive_subgroup U hU q (internalAddSubgroup U K) hKm hKpos H

theorem measurable_loeb_generated_subgroup
    (U : Ultrafilter ℕ) (hU : (U : Filter ℕ) ≤ atTop) (q : ℕ → ℕ+)
    (A : Set ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ))))
    (hAm : MeasurableSet A) (hApos : 0 < loebMeasure U hU A) :
    MeasurableSet (AddSubgroup.closure A : Set ((U : Filter ℕ).Product (fun n => ZMod (q n : ℕ)))) ∧
      0 < loebMeasure (X := fun n => ZMod (q n : ℕ)) U hU (AddSubgroup.closure A : Set _) := by
  apply measurable_loeb_subgroup_of_positive_inner U hU q
  apply hApos.trans_le
  rw [← internalInnerMeasure_eq U hU A hAm]
  exact internalInnerMeasure_mono U hU AddSubgroup.subset_closure

end Erdos335.Loeb

end
